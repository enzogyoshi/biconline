# Copie para ".env" (que NÃO vai para o Git) para testar no seu PC com: npm.cmd run dev

# Modo de testes: permite entrar sem token (só para desenvolvimento!)
MODO_DEV=true

# Nomes que viram moderador no modo de testes (separados por vírgula)
DEV_MODERADORES=gabryel

# Segredo compartilhado com o PHP (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CHAT_SEGREDO=

# Sites que podem embutir o chat / conectar nele (separados por vírgula)
ORIGENS_PERMITIDAS=http://localhost

PORT=3000
